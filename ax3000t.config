CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssh-sftp-server=y
# The router profile lists the plain "dnsmasq" variant in DEFAULT_PACKAGES, so it
# must be disabled explicitly. Without this line defconfig keeps both variants
# enabled and package/install dies with an opkg clash on /etc/init.d/dnsmasq.
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_adblock-fast=y
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_coreutils-sort=y
# TUN is NOT built into the kernel on this target: target/linux/generic/config-6.6
# contains "# CONFIG_TUN is not set" and mediatek/filogic does not override it, so
# /dev/net/tun only exists once this module is installed. UU Game Booster needs it
# and otherwise fails with "init tun device failed".
# Cost: 25.7 KiB ipk / 80 KiB installed.
CONFIG_PACKAGE_kmod-tun=y
# nft_compat lets xtables-nft express iptables matches/targets (DNAT, MARK, ...)
# as native nft expressions. On this target nf_tables is present but nft_compat is
# not, so `xtables-nft-multi iptables-nft -j DNAT` fails with
#   "Extension DNAT revision 0 not supported, missing kernel module?"
# UU Game Booster's NAT capability check then fails and it refuses to accelerate
# any device ("点加速失败"), even though it can already list devices.
# kmod-nf-ipt supplies the x_tables/ip_tables objects nft_compat links against.
# These must come from this build's own kernel tree: a DIY AX3000T image has a
# private kernel ABI hash, so no published kmod feed will ever match it.
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-nf-ipt=y
# OpenClash, pinned to vernesong/OpenClash v0.47.156 and added from source by the
# workflow. luci-compat and the kmod selections below are what its Makefile would
# pull in anyway via PACKAGE_firewall4; they are listed explicitly so the symbol
# check in build.yml is meaningful rather than incidental.
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
# Runtime libraries for the prebuilt Ruby that files/ supplies. Upstream
# libruby3.3 declares Depends: libc, libpthread, librt, libgmp10, zlib, so these
# two have to be in the image even though nothing compiles Ruby here.
CONFIG_PACKAGE_libgmp10=y
CONFIG_PACKAGE_zlib=y

