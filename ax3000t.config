CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_openssh-sftp-server=y
# The router profile lists the plain "dnsmasq" variant in DEFAULT_PACKAGES, so it
# must be disabled explicitly. Without this line defconfig keeps both variants
# enabled and package/install dies with an opkg clash on /etc/init.d/dnsmasq.
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_adblock-fast=y
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_coreutils-sort=y
# TUN is NOT built into the kernel on this target: target/linux/generic/config-6.6
# contains "# CONFIG_TUN is not set" and mediatek/filogic does not override it, so
# /dev/net/tun only exists once this module is installed. UU Game Booster needs it
# and otherwise fails with "init tun device failed".
# Cost: 25.7 KiB ipk / 80 KiB installed.
CONFIG_PACKAGE_kmod-tun=y

